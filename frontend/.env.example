# VortiCast Frontend Environment Configuration

# Backend API Base URL (leave empty or use http://localhost:8000/api/v1 when backend is active)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Use mock data fallback when backend is unavailable or for local demonstration
# Set to 'false' to enforce direct connection to live API
VITE_USE_MOCK_DATA=true

# Map Tile Server (CartoDB Dark Matter by default)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
