# ==============================================================================
# VortiCast Frontend Environment Configuration Template
# Copy this file to .env in the frontend directory:
#   cp .env.example .env
#
# NOTE: All variables prefixed with VITE_ are embedded into client-side JavaScript
# bundles at build time. NEVER place secrets, database credentials, or private
# keys in this file!
# ==============================================================================

# Backend API Base URL
# Points to the FastAPI backend API prefix.
# Leave empty or set to http://localhost:8000/api/v1 for standard local development.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Meteorological Telemetry Mode
# Set to 'true' to enable the built-in verified benchmark demonstration dataset.
# Set to 'false' to enforce direct connection to the live backend API.
VITE_USE_MOCK_DATA=true

# Geographic Map Configuration (Leaflet)
# Tile server URL template (CartoDB Dark Matter theme by default)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
