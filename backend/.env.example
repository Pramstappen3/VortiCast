# ==============================================================================
# VortiCast Backend Environment Configuration Template
# Copy this file to .env in the backend directory:
#   cp .env.example .env
# ==============================================================================

# Application Metadata
PROJECT_NAME="VortiCast"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server & Routing
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration
# Comma-separated list of allowed origins permitted to query the API.
# Include frontend development server origins (Vite default: port 5173).
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration
# Default: Zero-configuration local SQLite database (stored in backend/vorticast.db).
DATABASE_URL="sqlite:///./vorticast.db"

# Optional: PostgreSQL connection string (e.g., when running docker-compose up -d):
# DATABASE_URL="postgresql+psycopg2://vorticast:vorticast_password@localhost:5432/vorticast"

# Storage & Model Artifact Paths (relative paths resolve against backend root)
ARTIFACTS_DIR="./data/artifacts"
DATA_RAW_DIR="./data/raw"
DATA_PROCESSED_DIR="./data/processed"

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
