# ==============================================================================
# VortiCast ML Environment Configuration Template
# Copy this file to .env in the ml directory:
#   cp .env.example .env
# ==============================================================================

# Application & Environment
ML_ENV="development"
LOG_LEVEL="INFO"
RANDOM_SEED=42

# Data Directory Paths (relative to ml/ or absolute)
DATA_RAW_DIR="./data/raw"
DATA_PROCESSED_DIR="./data/processed"
DATA_EXTERNAL_DIR="./data/external"

# Model Artifact Storage
MODEL_REGISTRY_DIR="./saved_models"

# External Meteorological Data Sources / APIs (Placeholders)
# NO actual secrets, API keys, or credentials should be committed.
IMD_DATA_API_URL="https://api.example.gov/cyclone/data"
IMD_API_KEY="your_api_key_here"
NOAA_IBTRACS_URL="https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r00/access/netcdf"

# Backend Integration Endpoint (for inference serving / synchronization)
BACKEND_API_BASE_URL="http://localhost:8000/api/v1"

