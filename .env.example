# VortiCast Environment Configuration
PROJECT_NAME="VortiCast"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration
# Default development mode uses SQLite for quick zero-setup testing.
# For PostgreSQL production/local docker:
# DATABASE_URL="postgresql+psycopg2://vorticast:vorticast@localhost:5432/vorticast"
DATABASE_URL="sqlite:///./vorticast.db"

# Model Artifacts Directory
ARTIFACTS_DIR="./data/artifacts"
DATA_RAW_DIR="./data/raw"
DATA_PROCESSED_DIR="./data/processed"

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
